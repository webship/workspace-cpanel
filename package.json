{
  "name": "@webship.co/workspace-cpanel",
  "version": "1.0.13",
  "description": "cPanel hosting for Webship Workspace: the CPANEL menu on every site row, the account's domains as live sites, get database and files over SSH, deploy with rsync, the error log, the cPanel console. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A provider of @webship.co/workspace-hosting.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-cpanel.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "cpanel",
    "label": "cPanel",
    "needs": {
      "plugins": [
        [
          "dev",
          "test",
          "demos",
          "sandboxes",
          "projects"
        ],
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        "ssh",
        "rsync",
        "curl",
        "python3"
      ]
    },
    "settingsFile": "plugin.cpanel.settings.yml",
    "settingsTemplate": "config/plugin.cpanel.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "cpanel",
    "typeActions": {
      "cpanel": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-cpanel.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-cpanel.sh",
        "scripts/functions/fun-cpanel-tool.sh"
      ],
      "args": [
        "scripts/args/arg-cpanel.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/cpanel-deployer.md"
      ],
      "skills": [
        "ai/skills/cpanel-hosting"
      ],
      "commands": [
        "ai/commands/cpanel-status.md"
      ],
      "prompts": [
        "ai/prompts/cpanel-test-then-deploy.md"
      ]
    },
    "features": [
      "features/cpanel.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-hosting": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
